package views

import "github.com/mauv0809/crispy-broccoli/internal/strategy"
import "fmt"

templ StrategiesList(strategies []strategy.Strategy) {
	@Layout("Strategies") {
		<div class="space-y-4 sm:space-y-6">
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
				<div>
					<h1 class="text-xl sm:text-2xl font-bold text-primary">Strategies</h1>
					<p class="text-base-content/70 text-sm mt-1">Manage your stock screening strategies</p>
				</div>
				<a href="/strategies/new" class="btn btn-primary gap-1" title="New Strategy">
					<span class="text-lg font-bold">+</span>
					<span>New</span>
				</a>
			</div>

			if len(strategies) == 0 {
				<div class="card bg-base-200">
					<div class="card-body items-center text-center py-8 sm:py-12">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 sm:h-16 sm:w-16 text-base-content/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
						</svg>
						<h3 class="text-base sm:text-lg font-semibold">No strategies yet</h3>
						<p class="text-base-content/70 text-sm">Create your first strategy to start screening stocks</p>
						<a href="/strategies/new" class="btn btn-sm btn-primary mt-4">Create Strategy</a>
					</div>
				</div>
			} else {
				<div class="grid gap-3 sm:gap-4">
					for _, s := range strategies {
						@StrategyCard(s)
					}
				</div>
			}
		</div>
	}
}

templ StrategyCard(s strategy.Strategy) {
	<div class="card bg-base-200 hover:bg-base-300 transition-colors">
		<div class="card-body p-4 sm:p-6">
			<div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
				<div class="flex-1 min-w-0">
					<div class="flex items-center gap-2 flex-wrap">
						<h3 class="card-title text-base">{ s.Name }</h3>
						if s.IsDefault {
							<span class="badge badge-primary badge-sm">Default</span>
						}
					</div>
					<p class="text-base-content/70 mt-1 text-sm line-clamp-2">{ s.Description }</p>
					<div class="flex flex-wrap gap-2 mt-2">
						<span class="badge badge-outline badge-sm">
							{ fmt.Sprintf("%d filters", len(s.Rules.Filters)) }
						</span>
						<span class="badge badge-outline badge-sm">
							{ fmt.Sprintf("%d ranking", len(s.Rules.Ranking)) }
						</span>
						<span class="badge badge-outline badge-sm">
							{ s.Rules.Dimension }
						</span>
						<span class="badge badge-outline badge-sm">
							{ fmt.Sprintf("Top %d", s.Rules.Limit) }
						</span>
					</div>
				</div>
				<div class="flex gap-2 shrink-0">
					<a
						href={ templ.SafeURL(fmt.Sprintf("/strategies/%d", s.ID)) }
						class="btn btn-sm btn-primary"
					>
						View
					</a>
					<div class="dropdown dropdown-end">
						<label tabindex="0" class="btn btn-sm btn-ghost">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/>
							</svg>
						</label>
						<ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-lg bg-base-100 rounded-box w-36 sm:w-40">
							<li>
								<a href={ templ.SafeURL(fmt.Sprintf("/strategies/%d/edit", s.ID)) }>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
									</svg>
									Edit
								</a>
							</li>
							if !s.IsDefault {
								<li>
									<button
										class="text-error"
										hx-delete={ fmt.Sprintf("/api/strategies/%d", s.ID) }
										hx-confirm="Are you sure you want to delete this strategy?"
										hx-target="closest .card"
										hx-swap="outerHTML swap:0.3s"
									>
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
										</svg>
										Delete
									</button>
								</li>
							}
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
}
