# Template for `.kamal/secrets` (the real file is gitignored).
#
# This file uses `$VAR` references resolved from the env at `kamal deploy`
# time. Two ways to satisfy them:
#
# - CI (.github/workflows/deploy.yml): sets each var from a GitHub Secret.
# - Local laptop deploys: not the recommended path — see deploy workflow's
#   `workflow_dispatch` for manual deploys instead. If you really want
#   local, export each var in your shell (or use direnv) before `kamal`.

# Registry — CI passes secrets.GITHUB_TOKEN through as KAMAL_REGISTRY_PASSWORD.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Database: full DSN (Postgres password is embedded, so the whole URL is secret).
# Host `deepvalue-db` resolves to the Kamal accessory on the service network.
DATABASE_URL=$DATABASE_URL

# Postgres password for the accessory container. MUST match what's embedded
# in DATABASE_URL above.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# 32-byte hex session signing key. Generate once with: openssl rand -hex 32
SESSION_KEY=$SESSION_KEY

# External API keys
NASDAQ_API_KEY=$NASDAQ_API_KEY
TIINGO_API_KEY=$TIINGO_API_KEY

# Optional — leave the GH Secret unset to deploy without these
SENTRY_DSN=$SENTRY_DSN
GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET
RESEND_API_KEY=$RESEND_API_KEY
