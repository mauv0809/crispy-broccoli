package views

import (
	"fmt"

	"github.com/shopspring/decimal"

	"github.com/mauv0809/crispy-broccoli/internal/portfolio"
)

// PortfolioListItem is a row in the portfolio list. The handler enriches
// each portfolio with strategy name, current value, and a pending-proposal
// flag so the view can stay dumb.
type PortfolioListItem struct {
	Portfolio    portfolio.Portfolio
	StrategyName string
	CurrentValue decimal.Decimal
	ReturnAmount decimal.Decimal
	ReturnPct    decimal.Decimal
	HasPending   bool
}

templ PortfoliosList(items []PortfolioListItem) {
	@Layout("Portfolios") {
		<div class="space-y-4 sm:space-y-6">
			<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
				<div>
					<h1 class="text-xl sm:text-2xl font-bold text-primary">Portfolios</h1>
					<p class="text-base-content/70 text-sm mt-1">Live strategies running on real capital</p>
				</div>
				<a href="/portfolios/new" class="btn btn-primary gap-1" title="New Portfolio">
					<span class="text-lg font-bold">+</span>
					<span>New</span>
				</a>
			</div>

			if len(items) == 0 {
				<div class="card bg-base-200">
					<div class="card-body items-center text-center py-8 sm:py-12">
						<h3 class="text-base sm:text-lg font-semibold">No portfolios yet</h3>
						<p class="text-base-content/70 text-sm">Attach a verified strategy to start tracking real performance</p>
						<a href="/portfolios/new" class="btn btn-sm btn-primary mt-4">Create Portfolio</a>
					</div>
				</div>
			} else {
				<div class="grid gap-3 sm:gap-4 sm:grid-cols-2">
					for _, it := range items {
						@portfolioCard(it)
					}
				</div>
			}
		</div>
	}
}

templ portfolioCard(it PortfolioListItem) {
	<a class="card bg-base-100 shadow-sm hover:shadow-md transition" href={ templ.SafeURL(fmt.Sprintf("/portfolios/%d", it.Portfolio.ID)) }>
		<div class="card-body p-4 sm:p-5 space-y-2">
			<div class="flex items-start justify-between gap-2">
				<h2 class="card-title text-base sm:text-lg">{ it.Portfolio.Name }</h2>
				if it.HasPending {
					<span class="badge badge-warning whitespace-nowrap">Rebalance ready</span>
				}
			</div>
			<p class="text-sm text-base-content/70">
				{ it.StrategyName } &middot; { string(it.Portfolio.Cadence) }
			</p>
			<div class="flex items-baseline gap-3 pt-1">
				<span class="text-lg sm:text-xl font-semibold">${ it.CurrentValue.StringFixed(2) }</span>
				<span class={ "text-sm", returnColorClass(it.ReturnAmount) }>
					{ formatReturn(it.ReturnAmount, it.ReturnPct) }
				</span>
			</div>
		</div>
	</a>
}

// returnColorClass returns the Tailwind text-color class for a return amount:
// success when positive, error when negative, base-content/70 when zero.
func returnColorClass(amt decimal.Decimal) string {
	if amt.IsPositive() {
		return "text-success"
	}
	if amt.IsNegative() {
		return "text-error"
	}
	return "text-base-content/70"
}

// formatReturn renders "$X.XX (Y.Y%)" with the appropriate sign. Used in
// both the list cards and the detail page so the convention stays consistent.
func formatReturn(amt, pct decimal.Decimal) string {
	sign := ""
	if amt.IsPositive() {
		sign = "+"
	}
	return fmt.Sprintf("%s$%s (%s%s%%)", sign, amt.StringFixed(2), sign, pct.StringFixed(2))
}
