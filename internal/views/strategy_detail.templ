package views

import "github.com/mauv0809/crispy-broccoli/internal/strategy"
import "fmt"

templ StrategyDetail(s strategy.Strategy) {
	@Layout(s.Name) {
		<div class="space-y-4 sm:space-y-6">
			<!-- Header -->
			<div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
				<div>
					<div class="flex items-center gap-2 mb-2">
						<a href="/strategies" class="btn btn-ghost btn-sm">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
							</svg>
							Back
						</a>
					</div>
					<h1 class="text-xl sm:text-2xl font-bold text-primary">{ s.Name }</h1>
					<p class="text-base-content/70 text-sm mt-1">{ s.Description }</p>
				</div>
				<div class="flex gap-2">
					<a href={ templ.SafeURL(fmt.Sprintf("/strategies/%d/edit", s.ID)) } class="btn btn-outline btn-sm">
						Edit
					</a>
					<button
						class="btn btn-primary btn-sm [&.htmx-request]:loading [&.htmx-request]:pointer-events-none"
						hx-post={ fmt.Sprintf("/api/strategies/%d/run", s.ID) }
						hx-target="#execution-results"
						hx-swap="innerHTML"
						hx-on::after-request="htmx.trigger(document.body, 'strategyRunComplete')"
					>
						Run
					</button>
					if !s.IsDefault {
						<button
							class="btn btn-outline btn-error btn-sm"
							hx-delete={ fmt.Sprintf("/api/strategies/%d", s.ID) }
							hx-confirm="Are you sure you want to delete this strategy? This cannot be undone."
							hx-on::after-request="if(event.detail.successful) window.location.href='/strategies'"
						>
							Delete
						</button>
					}
				</div>
			</div>

			<!-- Strategy Configuration -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
				<!-- Filters -->
				<div class="card bg-base-200">
					<div class="card-body">
						<h3 class="card-title text-sm font-medium text-base-content/70">Filters</h3>
						if len(s.Rules.Filters) == 0 {
							<p class="text-base-content/50 text-sm">No filters configured</p>
						} else {
							<div class="space-y-2 mt-2">
								for _, f := range s.Rules.Filters {
									<div class="flex items-center gap-2 text-sm bg-base-100 rounded-lg px-3 py-2">
										<span class="font-medium text-primary">{ f.Field }</span>
										<span class="text-base-content/70">{ f.Operator }</span>
										if f.Value != nil {
											<span class="font-mono">{ fmt.Sprintf("%v", f.Value) }</span>
										}
									</div>
								}
							</div>
						}
					</div>
				</div>

				<!-- Ranking -->
				<div class="card bg-base-200">
					<div class="card-body">
						<h3 class="card-title text-sm font-medium text-base-content/70">Ranking Criteria</h3>
						if len(s.Rules.Ranking) == 0 {
							<p class="text-base-content/50 text-sm">No ranking configured</p>
						} else {
							<div class="space-y-2 mt-2">
								for _, r := range s.Rules.Ranking {
									<div class="flex items-center justify-between bg-base-100 rounded-lg px-3 py-2">
										<div class="flex items-center gap-2">
											<span class="font-medium text-primary">{ r.Field }</span>
											if r.Direction == "asc" {
												<span class="badge badge-sm badge-success">Low is better</span>
											} else {
												<span class="badge badge-sm badge-info">High is better</span>
											}
										</div>
										<span class="font-mono text-sm">{ fmt.Sprintf("%d%%", r.Weight) }</span>
									</div>
								}
							</div>
						}
					</div>
				</div>
			</div>

			<!-- Settings Summary -->
			<div class="flex flex-wrap gap-4">
				<div class="stat bg-base-200 rounded-lg px-4 py-2">
					<div class="stat-title text-xs">Dimension</div>
					<div class="stat-value text-lg">{ s.Rules.Dimension }</div>
				</div>
				<div class="stat bg-base-200 rounded-lg px-4 py-2">
					<div class="stat-title text-xs">Portfolio Size</div>
					<div class="stat-value text-lg">{ fmt.Sprintf("%d", s.Rules.Limit) }</div>
				</div>
				if s.Rules.Universe != "" {
					<div class="stat bg-base-200 rounded-lg px-4 py-2">
						<div class="stat-title text-xs">Universe</div>
						<div class="stat-value text-lg">
							if s.Rules.Universe == "sp500" {
								S&P 500
							} else {
								{ s.Rules.Universe }
							}
						</div>
					</div>
				}
				if s.IsDefault {
					<div class="stat bg-primary/10 rounded-lg px-4 py-2">
						<div class="stat-title text-xs">Type</div>
						<div class="stat-value text-lg text-primary">Default</div>
					</div>
				}
				if len(s.Rules.Weights) > 0 {
					<div class="stat bg-base-200 rounded-lg px-4 py-2">
						<div class="stat-title text-xs">Custom Weights</div>
						<div class="stat-value text-sm flex flex-wrap gap-1">
							for i, w := range s.Rules.Weights {
								<span class="badge badge-sm badge-outline">
									#{ fmt.Sprintf("%d", i+1) }: { fmt.Sprintf("%.0f%%", w*100) }
								</span>
							}
						</div>
					</div>
				}
			</div>

			<!-- Execution Results -->
			<div class="card bg-base-200">
				<div class="card-body">
					<h3 class="card-title">Execution Results</h3>
					<div id="execution-results">
						<p class="text-base-content/70">Click "Run Strategy" to execute and see recommendations.</p>
					</div>
				</div>
			</div>

			<!-- Backtesting -->
			<div class="card bg-base-200">
				<div class="card-body">
					<h3 class="card-title">
						Historical Backtest
						<span class="badge badge-sm badge-outline">vs SPY</span>
					</h3>
					<p class="text-base-content/70 text-sm mb-4">
						Simulate how this strategy would have performed historically against the S&P 500 benchmark.
					</p>

					<!-- Backtest Configuration Form -->
					<form
						hx-post={ fmt.Sprintf("/api/strategies/%d/backtest-htmx", s.ID) }
						hx-target="#backtest-results"
						hx-swap="innerHTML"
						class="grid grid-cols-2 md:grid-cols-4 gap-4"
					>
						<div class="form-control">
							<label class="label">
								<span class="label-text text-xs">Start Date</span>
							</label>
							<input
								type="date"
								name="start_date"
								value="2020-01-01"
								class="input input-sm input-bordered"
								required
							/>
						</div>
						<div class="form-control">
							<label class="label">
								<span class="label-text text-xs">End Date</span>
							</label>
							<input
								type="date"
								name="end_date"
								value="2024-12-31"
								class="input input-sm input-bordered"
								required
							/>
						</div>
						<div class="form-control">
							<label class="label">
								<span class="label-text text-xs">Rebalance</span>
							</label>
							<select name="rebalance_freq" class="select select-sm select-bordered">
								<option value="semi-annual" selected>Semi-Annual</option>
								<option value="quarterly">Quarterly</option>
								<option value="annual">Annual</option>
							</select>
						</div>
						<div class="form-control">
							<label class="label">
								<span class="label-text text-xs">Initial Capital</span>
							</label>
							<input
								type="number"
								name="initial_capital"
								value="10000"
								min="1000"
								step="1000"
								class="input input-sm input-bordered"
							/>
						</div>
						<div class="col-span-2 md:col-span-4 flex items-center gap-3">
							<button
								type="submit"
								class="btn btn-sm btn-primary [&.htmx-request]:loading [&.htmx-request]:pointer-events-none"
							>
								Run Backtest
							</button>
							<span class="text-xs text-base-content/50">
								Uses Nasdaq Data Link for adjusted prices (SEP/SFP)
							</span>
						</div>
					</form>

					<!-- Backtest Results -->
					<div id="backtest-results" class="mt-4">
						<!-- Results will be loaded here via HTMX -->
					</div>
				</div>
			</div>

			<!-- Run History -->
			<div class="card bg-base-200">
				<div class="card-body">
					<h3 class="card-title">Recent Runs</h3>
					<div
						id="run-history"
						hx-get={ fmt.Sprintf("/api/strategies/%d/runs?limit=5", s.ID) }
						hx-trigger="load, strategyRunComplete from:body"
						hx-target="this"
					>
						<span class="loading loading-spinner loading-sm"></span>
						Loading history...
					</div>
				</div>
			</div>
		</div>
	}
}

templ ExecutionResults(result strategy.RunResult) {
	<div class="space-y-4">
		<!-- Stats -->
		<div class="flex flex-wrap gap-4 text-sm">
			<div class="badge badge-lg badge-outline">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
				</svg>
				{ fmt.Sprintf("%dms", result.ExecutionTimeMs) }
			</div>
			<div class="badge badge-lg badge-outline">
				Screened { fmt.Sprintf("%d", result.StocksScreened) } stocks
			</div>
			<div class="badge badge-lg badge-primary">
				{ fmt.Sprintf("%d", result.StocksMatched) } matches
			</div>
		</div>

		<!-- Recommendations Table -->
		if len(result.Recommendations) > 0 {
			<div class="overflow-x-auto">
				<table class="table table-zebra">
					<thead>
						<tr>
							<th>Rank</th>
							<th>Ticker</th>
							<th>Company</th>
							<th>Sector</th>
							<th>Score</th>
						</tr>
					</thead>
					<tbody>
						for _, rec := range result.Recommendations {
							<tr class={ templ.KV("bg-warning/10", rec.IsFallback) }>
								<td class="font-bold text-primary">
									{ fmt.Sprintf("#%d", rec.Rank) }
									if rec.IsFallback {
										<span class="badge badge-xs badge-warning ml-1" title="Fallback pick (didn't pass all filters)">F</span>
									}
								</td>
								<td class="font-mono font-bold">{ rec.Ticker }</td>
								<td>{ rec.CompanyName }</td>
								<td class="text-sm text-base-content/70">{ rec.Sector }</td>
								<td>
									<div class="badge badge-primary">{ fmt.Sprintf("%.1f", rec.Score) }</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			<div class="alert alert-warning">
				<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
				</svg>
				<span>No stocks matched the strategy criteria. Try adjusting the filters.</span>
			</div>
		}
	</div>
}

templ RunHistoryList(runs []strategy.StrategyRun) {
	if len(runs) == 0 {
		<p class="text-base-content/50 text-sm">No runs yet</p>
	} else {
		<div class="overflow-x-auto">
			<table class="table table-sm">
				<thead>
					<tr>
						<th>Date</th>
						<th>Matched</th>
						<th>Time</th>
					</tr>
				</thead>
				<tbody>
					for _, run := range runs {
						<tr>
							<td class="text-sm">{ run.RunAt.Format("Jan 2, 2006 15:04") }</td>
							<td>
								if len(run.Results) > 0 {
									for _, rec := range run.Results {
										<span class="badge badge-xs badge-primary font-mono">{ rec.Ticker }</span>{ " " }
									}
								} else {
									<span class="badge badge-sm">{ fmt.Sprintf("%d stocks", run.StocksMatched) }</span>
								}
							</td>
							<td class="text-sm text-base-content/70">{ fmt.Sprintf("%dms", run.ExecutionTimeMs) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

