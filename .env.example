# Database connection
DATABASE_URL="postgres://value_user:value_pass@localhost:5432/value_db?sslmode=disable"

# Server port
PORT=8080

# Nasdaq Data Link API key (for SEP equity prices and fundamentals)
NASDAQ_API_KEY="your-nasdaq-api-key"

# Tiingo API key (for ETF benchmark prices like SPY, QQQ)
# Free tier: 1000 req/day, 50 req/hour, 30+ years history
TIINGO_API_KEY="your-tiingo-api-key"
