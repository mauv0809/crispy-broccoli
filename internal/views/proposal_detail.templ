package views

import (
	"fmt"

	"github.com/mauv0809/crispy-broccoli/internal/portfolio"
	"github.com/mauv0809/crispy-broccoli/internal/proposal"
)

type ProposalDetailData struct {
	Portfolio    portfolio.Portfolio
	Proposal     proposal.Proposal
	StrategyName string
}

templ ProposalDetail(d ProposalDetailData) {
	@Layout(fmt.Sprintf("Rebalance — %s", d.Portfolio.Name)) {
		<div class="space-y-4 sm:space-y-6 max-w-3xl">
			<header>
				<h1 class="text-xl sm:text-2xl font-bold text-primary">Rebalance proposal</h1>
				<p class="text-base-content/70 text-sm mt-1">
					<a href={ templ.SafeURL(fmt.Sprintf("/portfolios/%d", d.Portfolio.ID)) } class="link">{ d.Portfolio.Name }</a>
					{ " · " }
					{ d.StrategyName }
					{ " · generated " }
					{ d.Proposal.GeneratedAt.Format("Jan 2, 2006 15:04") }
				</p>
			</header>

			<form id="accept-form"
			      method="POST"
			      action={ templ.SafeURL(fmt.Sprintf("/portfolios/%d/proposals/%d/accept", d.Portfolio.ID, d.Proposal.ID)) }
			      class="space-y-4">
				<input type="hidden" name="_csrf" value={ CSRFFromContext(ctx) }/>

				<div class="card bg-base-100 shadow-sm">
					<div class="card-body p-4 sm:p-5 space-y-3">
						<div class="form-control max-w-xs">
							<label class="label" for="capital_change">
								<span class="label-text">Capital change ($)</span>
							</label>
							<input id="capital_change"
							       name="capital_change"
							       type="number"
							       step="0.01"
							       value={ d.Proposal.CapitalChange.StringFixed(2) }
							       class="input input-bordered"
							       hx-post={ fmt.Sprintf("/portfolios/%d/proposals/%d/recompute", d.Portfolio.ID, d.Proposal.ID) }
							       hx-trigger="change"
							       hx-target="#picks-table"
							       hx-swap="outerHTML"/>
							<label class="label">
								<span class="label-text-alt text-base-content/60">Positive to deposit, negative to withdraw. Picks recompute on change.</span>
							</label>
						</div>

						@ProposalPicksTable(PicksTableData{
							ProposalID:   d.Proposal.ID,
							PortfolioID:  d.Portfolio.ID,
							Picks:        d.Proposal.Picks,
							DeployAmount: d.Proposal.DeployAmount,
						})
					</div>
				</div>

				<div class="flex flex-wrap justify-end gap-2">
					<button type="button"
					        class="btn btn-ghost btn-sm"
					        hx-post={ fmt.Sprintf("/portfolios/%d/proposals/%d/skip", d.Portfolio.ID, d.Proposal.ID) }
					        hx-confirm="Skip this rebalance? Your portfolio won't change but the cadence advances."
					        hx-target="body">
						Skip whole proposal
					</button>
					<button type="submit" class="btn btn-primary btn-sm">Accept proposal</button>
				</div>
			</form>
		</div>
	}
}
